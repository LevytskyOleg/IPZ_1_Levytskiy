<Window x:Class="BeautySalonApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Косметичний салон - Головне меню" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F5F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Використовуємо наш стиль HeaderStyle -->
            <TextBlock Text="Ласкаво просимо до салону краси!" 
                       Style="{StaticResource HeaderStyle}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Використовуємо наш стиль SalonButtonStyle -->
            <Button Content="Створити новий запис" 
                    Style="{StaticResource SalonButtonStyle}" 
                    Width="200" Height="40" 
                    Click="BtnNewBooking_Click"/>

            <Button Content="Вихід" 
                    Style="{StaticResource SalonButtonStyle}" 
                    Width="200" Height="40" 
                    Click="BtnExit_Click"/>

        </StackPanel>
    </Grid>
</Window>